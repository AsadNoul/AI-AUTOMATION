{
  "name": "Social Media Brand Monitor",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "hours",
              "hoursInterval": 2
            }
          ]
        }
      },
      "name": "Check Every 2 Hours",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1,
      "position": [250, 300]
    },
    {
      "parameters": {
        "query": "YourBrandName OR @YourTwitterHandle OR #YourHashtag",
        "count": 100,
        "returnAll": false
      },
      "name": "Search Twitter Mentions",
      "type": "n8n-nodes-base.twitter",
      "typeVersion": 1,
      "position": [500, 300],
      "credentials": {
        "twitterOAuth2Api": {
          "id": "11",
          "name": "Twitter OAuth2"
        }
      }
    },
    {
      "parameters": {
        "model": "gpt-4",
        "messages": {
          "values": [
            {
              "role": "system",
              "content": "Analyze this social media post and provide:\n1. Sentiment (positive/neutral/negative)\n2. Urgency level (low/medium/high)\n3. Topic category (product feedback/support request/general mention/complaint/praise)\n4. Whether it requires a response (yes/no)\n5. Suggested response (if applicable)\n\nBe concise and professional."
            },
            {
              "role": "user",
              "content": "=Post from @{{ $json.user.screen_name }}:\n{{ $json.text }}\n\nEngagement: {{ $json.retweet_count }} retweets, {{ $json.favorite_count }} likes"
            }
          ]
        }
      },
      "name": "AI Sentiment Analysis",
      "type": "n8n-nodes-base.openAi",
      "typeVersion": 1,
      "position": [750, 300]
    },
    {
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{ $json.sentiment }}",
              "operation": "equals",
              "value2": "negative"
            }
          ]
        },
        "combineOperation": "any"
      },
      "name": "Is Negative?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [1000, 300]
    },
    {
      "parameters": {
        "channel": "social-alerts",
        "text": "=🚨 Negative Brand Mention Alert!\n\nPlatform: Twitter\nFrom: @{{ $json.user.screen_name }}\nFollowers: {{ $json.user.followers_count }}\n\nPost: {{ $json.text }}\n\nSentiment: {{ $json.sentiment }}\nCategory: {{ $json.category }}\n\nSuggested Response:\n{{ $json.suggested_response }}\n\nView: {{ $json.tweet_url }}"
      },
      "name": "Alert Team - Urgent",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 1,
      "position": [1250, 200],
      "credentials": {
        "slackApi": {
          "id": "4",
          "name": "Slack"
        }
      }
    },
    {
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{ $json.requires_response }}",
              "operation": "equals",
              "value2": "yes"
            }
          ]
        }
      },
      "name": "Needs Response?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [1000, 500]
    },
    {
      "parameters": {
        "text": "={{ $json.suggested_response }}",
        "inReplyToStatusId": "={{ $json.id_str }}"
      },
      "name": "Auto Reply (Positive)",
      "type": "n8n-nodes-base.twitter",
      "typeVersion": 1,
      "position": [1250, 500]
    },
    {
      "parameters": {
        "table": "social_mentions",
        "columns": "platform, username, post_content, sentiment, category, urgency, response_sent, created_at, post_url",
        "values": "=twitter, {{ $json.user.screen_name }}, {{ $json.text }}, {{ $json.sentiment }}, {{ $json.category }}, {{ $json.urgency }}, {{ $json.auto_replied }}, {{ $json.created_at }}, {{ $json.tweet_url }}"
      },
      "name": "Log to Database",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2,
      "position": [1500, 300],
      "credentials": {
        "postgres": {
          "id": "5",
          "name": "PostgreSQL"
        }
      }
    },
    {
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{ $json.sentiment }}",
              "operation": "equals",
              "value2": "positive"
            }
          ],
          "number": [
            {
              "value1": "={{ $json.user.followers_count }}",
              "operation": "largerEqual",
              "value2": 10000
            }
          ]
        },
        "combineOperation": "all"
      },
      "name": "High-Value Positive?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [1000, 100]
    },
    {
      "parameters": {
        "channel": "marketing",
        "text": "=⭐ Great Brand Mention!\n\nInfluencer: @{{ $json.user.screen_name }} ({{ $json.user.followers_count }} followers)\n\n{{ $json.text }}\n\nEngagement: {{ $json.retweet_count }} RTs, {{ $json.favorite_count }} likes\n\nConsider: Like, retweet, or engage!\nView: {{ $json.tweet_url }}"
      },
      "name": "Share Win with Team",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 1,
      "position": [1250, 100]
    }
  ],
  "connections": {
    "Check Every 2 Hours": {
      "main": [
        [
          {
            "node": "Search Twitter Mentions",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Search Twitter Mentions": {
      "main": [
        [
          {
            "node": "AI Sentiment Analysis",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "AI Sentiment Analysis": {
      "main": [
        [
          {
            "node": "Is Negative?",
            "type": "main",
            "index": 0
          },
          {
            "node": "Needs Response?",
            "type": "main",
            "index": 0
          },
          {
            "node": "High-Value Positive?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Is Negative?": {
      "main": [
        [
          {
            "node": "Alert Team - Urgent",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Log to Database",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Needs Response?": {
      "main": [
        [
          {
            "node": "Auto Reply (Positive)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Auto Reply (Positive)": {
      "main": [
        [
          {
            "node": "Log to Database",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Alert Team - Urgent": {
      "main": [
        [
          {
            "node": "Log to Database",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "High-Value Positive?": {
      "main": [
        [
          {
            "node": "Share Win with Team",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Share Win with Team": {
      "main": [
        [
          {
            "node": "Log to Database",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  }
